    "@react-pdf/renderer": "^4.5.1",
    "@tiptap/extension-link": "^3.34.0",
    "@tiptap/extension-placeholder": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@types/nodemailer": "^8.0.0",
    "@uploadthing/react": "^7.3.3",
    "arctic": "^3.7.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jose": "^6.2.2",
    "lucide-react": "^1.7.0",
    "mermaid": "^12.2.0",
    "next": "^16.4.6",
    "nodemailer": "^10.6.0",
    "openai": "^7.10.0",
    "pg": "^8.20.0",
    "radix-ui": "^1.4.3",
