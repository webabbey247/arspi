{
  "name": "arspi",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "db:seed": "node node_modules/prisma-orm/build/index.js db seed --config prisma.orm.config.ts",
    "dev": "next dev",
    "db:migrate": "node node_modules/prisma-orm/build/index.js migrate deploy --config prisma.orm.config.ts",
    "db:push": "node node_modules/prisma-orm/build/index.js db push --config prisma.orm.config.ts",
    "db:link": "npx supabase link --project-ref wigticwhcnqeytetlypa",
    "postinstall": "node node_modules/prisma-orm/build/index.js generate --config prisma.orm.config.ts && node prisma/scripts/link-prisma-bins.mjs",
    "build": "node node_modules/prisma-orm/build/index.js generate --config prisma.orm.config.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "db:exec": "node node_modules/prisma-orm/build/index.js db execute --config prisma.orm.config.ts --file",
    "orm": "node node_modules/prisma-orm/build/index.js",
    "db:generate": "node node_modules/prisma-orm/build/index.js generate --config prisma.orm.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
