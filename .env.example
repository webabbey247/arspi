# ─────────────────────────────────────────────────────────────────────────────
# Environment variable reference for ARSPI
#
# On shared hosting (cPanel Node.js App):
#   Set these in cPanel → Node.js App → your app → Environment Variables tab.
#   Do NOT place a .env file on the server — Passenger does not load it.
#
# In GitHub Actions:
#   Add DATABASE_URL, NEXTAUTH_URL, NEXTAUTH_SECRET, NEXT_PUBLIC_APP_URL
#   under Settings → Secrets and variables → Actions (needed at build time).
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Supabase / PostgreSQL) ─────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# ── Session (lib/session.ts) ───────────────────────────────────────────────────
# NEXTAUTH_URL must be the exact URL users visit (no trailing slash) — also the
# base URL OAuth redirect URIs are built from (lib/oauth/providers.ts).
NEXTAUTH_URL=https://yourdomain.com
# Signs the access/refresh JWTs and the session cookie. Generate with:
#   openssl rand -base64 32
# Falls back to NEXTAUTH_SECRET, then JWT_SECRET, if unset (lib/env.ts).
SESSION_SECRET=replace-with-random-secret
# Cookie names — safe to leave at these defaults.
ACCESS_COOKIE_NAME=arspi-access
REFRESH_COOKIE_NAME=arspi-refresh
SESSION_COOKIE_NAME=arspi-session
# Login lockout (lib/login-rate-limit.ts) — locks an email+IP pair out after
# this many failed attempts, for this many seconds.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# ── App URL ──────────────────────────────────────────────────────────────────
# Used for Stripe redirects, password-reset links, OAuth redirect URIs AND all
# SEO output (canonical URLs, sitemap.xml, robots.txt, Open Graph tags).
# MUST be the real public origin in production — if it's wrong, the sitemap and
# canonicals you hand Google will point at the wrong host.
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# ── Email / SMTP ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your-smtp-password
SMTP_FROM=ARPS Institute <noreply@yourdomain.com>

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── UploadThing ───────────────────────────────────────────────────────────────
# Found in the UploadThing dashboard under API Keys
UPLOADTHING_TOKEN=...

# ── AI Course Builder (administrator/programs) ────────────────────────────────
# Anthropic — get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# OpenAI — get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── Social login (Google / LinkedIn — app/api/auth/oauth) ─────────────────────
# Google: console.cloud.google.com → APIs & Services → Credentials → OAuth
# client ID (Web application). Authorized redirect URI must be EXACTLY:
#   ${NEXTAUTH_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
# LinkedIn: developer.linkedin.com → your app → Auth. Requires the "Sign In
# with LinkedIn using OpenID Connect" product enabled. Redirect URI must be:
#   ${NEXTAUTH_URL}/api/auth/oauth/linkedin/callback
LINKEDIN_CLIENT_ID=...
LINKEDIN_CLIENT_SECRET=...

# ── Node.js ───────────────────────────────────────────────────────────────────
NODE_ENV=production
