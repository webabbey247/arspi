// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  INSTRUCTOR
  USER
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  // Present in the database but unused by the app: archiving a programme sends
  // it back to DRAFT. Kept here only so the schema still matches the live enum
  // — Postgres cannot drop a value from a type in place. Do not write it.
  ARCHIVED
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String? // nullable — OAuth users have no password
  role      Role       @default(USER)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())

  // Linked OAuth identities (Google, LinkedIn, …) — see services/oauth.service.ts
  accounts Account[]

  // Onboarding flags
  hasProfile   Boolean @default(false)
  hasInterests Boolean @default(false)

  // Email verification
  emailVerified            Boolean   @default(false)
  emailVerificationToken   String?   @unique
  emailVerificationExpires DateTime?

  // Relations
  profile             Profile?
  enrollments         Enrollment[]
  lessonCompletions   LessonCompletion[]
  lessonProgress      LessonProgress[]
  certificates        Certificate[]
  taughtCourses       Course[]             @relation("CourseInstructor")
  taughtWorkshops     Workshop[]           @relation("WorkshopInstructor")
  passwordResetTokens PasswordResetToken[]
  createdInsights     Insight[]            @relation("InsightAuthor")
  assessmentAttempts  AssessmentAttempt[]  @relation("AttemptStudent")
  gradedAttempts      AssessmentAttempt[]  @relation("AttemptGrader")
  courseGrades        CourseGrade[]
  studyPlans          StudyPlan[]

  @@map("users")
}

model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName      String?
  lastName       String?
  avatar         String? // URL to S3 / R2
  bio            String?
  phone          String?
  country        String?
  jobTitle       String?
  organisation   String?
  roleType       String?
  interests      String[] @default([])
  referralSource String?
  emailOptIn     Boolean  @default(true)

  // Address
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  dateOfBirth  DateTime?

  // Preferences
  language String?
  timezone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profiles")
}

// Linked OAuth identities — one row per (provider, providerAccountId) a user
// has signed in with. This app's own session cookies (lib/session.ts) are the
// only session mechanism; there is no separate NextAuth-style Session table.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String // "oauth"
  provider          String // "google" | "linkedin"
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// ============================================================
// COURSES
// ============================================================

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  courses   Course[]
  createdAt DateTime @default(now())

  @@map("categories")
}

model Course {
  id                  String       @id @default(cuid())
  title               String
  slug                String       @unique
  excerpt             String // renamed from description; short summary shown on cards
  thumbnail           String?
  price               Float        @default(0)
  pricing             String       @default("free") // "free" | "paid"
  paymentType         String? // "one-time" | "subscription" | "monthly" — only when pricing = "paid"
  level               CourseLevel  @default(BEGINNER)
  featured            Boolean      @default(false)
  predefinedAnalytics Boolean      @default(false) // when true, render Metrics + Social Proof publicly
  status              CourseStatus @default(PUBLISHED) // DRAFT = AI-generated / unfinished, hidden from public site

  // Programme details
  tagline        String?
  duration       String?
  format         String?
  startDate      String?
  endDate        String?
  cohortSize     Int?
  rating         Float?
  reviewCount    Int?
  enrolledCount  Int?
  countriesCount Int?

  // Rich content (JSON)
  overview           String?
  targetAudience     Json? // String[]
  learningObjectives Json? // String[]
  curriculum         Json? // { title, desc, lessons[] }[]
  whatIsIncluded     Json? // String[]
  faqs               Json? // { q, a }[]

  // Facilitators array (replaces standalone instructor columns)
  facilitators Json? // { name, imageUrl?, title, bio, credentials? }[]

  // Instructor (User relation)
  instructorId String
  instructor   User   @relation("CourseInstructor", fields: [instructorId], references: [id])

  // Category
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  // Lookup-table relations (replacing CourseLevel enum, format string, pricing string)
  programLevelId String?
  programLevel   ProgramLevel? @relation(fields: [programLevelId], references: [id])

  programFormatId String?
  programFormat   ProgramFormat? @relation(fields: [programFormatId], references: [id])

  programPricingId String?
  programPricing   ProgramPricing? @relation(fields: [programPricingId], references: [id])

  // ── Assessment & grading ─────────────────────────────────────────────────
  // Off by default so every existing programme keeps the old "finish every
  // lesson" certificate rule until an admin deliberately turns grading on.
  gradingEnabled          Boolean @default(false)
  quizWeight              Int     @default(50) // marks out of 100 from chapter quizzes
  projectWeight           Int     @default(50) // marks out of 100 from the project
  passMark                Int     @default(50) // overall marks needed, out of 100
  componentPassMark       Int     @default(50) // % needed within EACH component
  maxQuizAttempts         Int     @default(3)
  attemptCooldownHours    Int     @default(24)
  maxProjectResubmissions Int     @default(2)

  // Relations
  sections       Section[]
  enrollments    Enrollment[]
  lessonProgress LessonProgress[]
  certificates   Certificate[]
  tags           CourseTag[]
  assessments    Assessment[]
  grades         CourseGrade[]
  studyPlans     StudyPlan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("courses")
}

// ============================================================
// PROGRAM LOOKUP TABLES (Level / Format / Pricing)
// ============================================================
model ProgramLevel {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  courses   Course[]
  createdAt DateTime @default(now())

  @@map("program_levels")
}

model ProgramFormat {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  courses   Course[]
  createdAt DateTime @default(now())

  @@map("program_formats")
}

model ProgramPricing {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  courses   Course[]
  createdAt DateTime @default(now())

  @@map("program_pricing_options")
}

model CourseTag {
  id       String @id @default(cuid())
  name     String
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("course_tags")
}

// ============================================================
// SECTIONS + LESSONS
// ============================================================
model Section {
  id       String   @id @default(cuid())
  title    String
  order    Int
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]

  @@map("sections")
}

model Lesson {
  id          String             @id @default(cuid())
  title       String
  description String?
  videoUrl    String? // URL to hosted video
  duration    Int? // seconds
  order       Int
  isFree      Boolean            @default(false) // preview lessons
  sectionId   String
  section     Section            @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  completions LessonCompletion[]
  resources   LessonResource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("lessons")
}

model LessonResource {
  id       String @id @default(cuid())
  title    String
  url      String
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("lesson_resources")
}

// ============================================================
// ENROLLMENTS + PROGRESS
// ============================================================
model Enrollment {
  id          String           @id @default(cuid())
  userId      String
  courseId    String
  status      EnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?

  // Student's own rating of this program (1-5), and per-student card state —
  // distinct from Course.rating, which is the admin-set overall rating.
  studentRating Int?
  favorited     Boolean @default(false)
  archived      Boolean @default(false)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("enrollments")
}

model LessonCompletion {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("lesson_completions")
}

// Tracks per-student progress against a program's `Course.curriculum` JSON
// (chapter/lesson objects carry their own stable `id` — there is no relational
// Lesson row to key off, since curriculum content lives as JSON, not the
// Section/Lesson tables above). One row per student per course.
model LessonProgress {
  id            String   @id @default(cuid())
  userId        String
  courseId      String
  completedIds  Json // string[] — curriculum lesson ids the student has marked complete
  passedQuizIds Json     @default("[]") // string[] — quiz content-block ids answered correctly
  updatedAt     DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("lesson_progress")
}

// ============================================================
// CERTIFICATES
// ============================================================
model Certificate {
  id         String    @id @default(cuid())
  userId     String
  courseId   String
  verifyCode String    @unique @default(cuid())
  pdfUrl     String? // URL to generated PDF in S3 / R2
  issuedAt   DateTime  @default(now())
  expiresAt  DateTime? // null = never expires

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId]) // one cert per user per course
  @@map("certificates")
}

enum AssessmentKind {
  CHAPTER_QUIZ // auto-graded, drawn from a question pool
  PROJECT // file submission, graded by an instructor against a rubric
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED // answers/files in, awaiting scoring or a grader
  GRADED
  CHANGES_REQUESTED // project returned to the student for resubmission
}

/// A graded instrument. In-lesson quiz content-blocks stay unscored practice
/// gates; these are the only things that carry marks.
model Assessment {
  id           String         @id @default(cuid())
  courseId     String
  course       Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  kind         AssessmentKind
  title        String
  instructions String?

  /// CHAPTER_QUIZ only — the `id` of the chapter in Course.curriculum this
  /// assessment closes out. A plain string, because curriculum chapters live
  /// in JSON and have no row of their own; validate it still resolves before
  /// relying on it. Null for PROJECT, which is course-wide.
  chapterId String?

  /// CHAPTER_QUIZ: [{ id, prompt, options: string[], correctIndex, points }]
  /// The answer key never leaves the server — see stripAssessmentAnswers().
  questions Json?
  /// PROJECT: [{ id, criterion, maxPoints }]
  rubric    Json?

  /// Questions to draw per attempt (null = serve all). Drawing a subset from a
  /// larger pool is what stops a retake from being a memory test.
  drawCount      Int?
  shuffleOptions Boolean @default(true)
  orderIndex     Int     @default(0)

  attempts AssessmentAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@map("assessments")
}

model AssessmentAttempt {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation("AttemptStudent", fields: [userId], references: [id], onDelete: Cascade)

  attemptNo Int
  status    AttemptStatus @default(IN_PROGRESS)

  /// Voided attempts keep their history and their number but stop counting
  /// against the cap — this is how an instructor grants one more try without
  /// renumbering anything or loosening the policy for everyone else.
  voided Boolean @default(false)

  /// CHAPTER_QUIZ: the exact questions served for this attempt, answer key
  /// excluded — pinned at start so an edit to the assessment mid-attempt
  /// can't change what the student is answering.
  /// [{ id, prompt, options: string[], points }]
  servedQuestions Json?
  /// CHAPTER_QUIZ: { [questionId]: selectedIndex }
  answers         Json?
  /// CHAPTER_QUIZ: { [questionId]: number[] } mapping each SERVED option
  /// position back to its position in the authored question. Grading is done
  /// through this rather than by comparing option text, which silently
  /// mis-grades whenever two options share the same wording. Server-only —
  /// never include it in a student response.
  optionMap       Json?
  /// PROJECT: [{ url, name, size }] — uploaded via UploadThing
  files           Json?
  note            String?

  score        Float?
  maxScore     Float?
  passed       Boolean?
  /// PROJECT: { [criterionId]: points }
  rubricScores Json?
  feedback     String?

  gradedById String?
  gradedBy   User?   @relation("AttemptGrader", fields: [gradedById], references: [id])

  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  gradedAt    DateTime?

  @@unique([assessmentId, userId, attemptNo])
  @@index([userId, assessmentId])
  @@map("assessment_attempts")
}

/// Cached rollup of a student's marks for one course. Recomputed whenever an
/// attempt is scored — kept as a row so listings and the certificate check
/// don't have to replay every attempt.
model CourseGrade {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  quizMarks    Float   @default(0) // out of Course.quizWeight
  projectMarks Float   @default(0) // out of Course.projectWeight
  finalMarks   Float   @default(0) // out of 100
  quizPct      Float   @default(0) // component %, for the per-component pass rule
  projectPct   Float   @default(0)
  passed       Boolean @default(false)

  computedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@map("course_grades")
}

enum StudySessionStatus {
  PLANNED
  DONE
  MISSED
  SKIPPED
}

/// A student's self-paced timetable for one programme: when they intend to
/// study, from which the sessions below are generated.
model StudyPlan {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  /// Weekly availability: [{ weekday: 0-6 (Sun-Sat), start: "19:00", end: "21:00" }]
  /// A recurring pattern rather than explicit dates, so the plan can be
  /// re-flowed when a student falls behind without re-asking them anything.
  availability Json

  /// IANA zone the slots are expressed in. Stored because "19:00 Tuesday"
  /// means nothing without it, and a student may travel.
  timezone      String    @default("UTC")
  startDate     DateTime
  /// Set when the plan was built backwards from a deadline rather than
  /// forwards from availability — kept so the UI can say which it was.
  targetEndDate DateTime?

  sessions StudySession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@map("study_plans")
}

/// One materialised sitting. Rows rather than a computed projection because
/// students tick them off, miss them and reschedule — that needs identity.
model StudySession {
  id     String    @id @default(cuid())
  planId String
  plan   StudyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  /// Local date of the sitting at midnight UTC, paired with startMinute below
  /// rather than stored as an instant: a timezone change should move the clock
  /// time with the student, not silently shift every session.
  date        DateTime
  startMinute Int // minutes from local midnight
  endMinute   Int

  /// Curriculum lesson ids assigned to this sitting, in order. Lessons are
  /// never split across sittings — a half-watched lesson isn't progress.
  lessonIds        Json
  /// Denormalised for display, so rendering a plan doesn't need the curriculum.
  lessonTitles     Json
  chapterTitle     String?
  estimatedMinutes Int     @default(0)

  status      StudySessionStatus @default(PLANNED)
  completedAt DateTime?

  @@index([planId, date])
  @@map("study_sessions")
}

// ============================================================
// PAYMENTS
// ============================================================

model Payment {
  id              String        @id @default(cuid())
  userId          String
  courseId        String
  amount          Float
  currency        String        @default("USD")
  status          PaymentStatus @default(PENDING)
  stripePaymentId String?       @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("payments")
}

// ============================================================
// WORKSHOPS
// ============================================================

enum WorkshopType {
  FREE
  PAID
}

enum WorkshopCategory {
  SHORT_COURSE
  WEBINAR
  MASTERCLASS
  CONFERENCE
  WORKSHOP
}

enum WorkshopPaymentMethod {
  CARD
  PAYPAL
  BANK_TRANSFER
}

enum WorkshopRegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Workshop {
  id             String           @id @default(cuid())
  title          String
  slug           String           @unique
  description    String           @db.Text
  type           WorkshopType     @default(FREE)
  category       WorkshopCategory @default(WORKSHOP)
  fee            Float            @default(0)
  featured       Boolean          @default(false)
  published      Boolean          @default(false)
  date           DateTime?
  startTime      String           @default("")
  endTime        String           @default("")
  timezone       String           @default("UTC")
  level          String           @default("BEGINNER")
  facilitator    String           @default("")
  facilitators   Json?
  medium         String           @default("ONLINE")
  onlinePlatform String?
  onlineLink     String?
  venueAddress   String?
  venueCity      String?
  venueState     String?
  venueCountry   String?
  capacity       Int?
  registered     Int              @default(0)
  coverImage     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  instructorId String?
  instructor   User?   @relation("WorkshopInstructor", fields: [instructorId], references: [id], onDelete: SetNull)

  registrations WorkshopRegistration[]

  @@map("workshops")
}

model WorkshopRegistration {
  id                      String                     @id @default(cuid())
  firstName               String
  lastName                String
  email                   String
  organisation            String?
  workshopTitle           String
  workshopDate            String
  workshopTime            String
  fee                     Float
  paymentMethod           WorkshopPaymentMethod?
  status                  WorkshopRegistrationStatus @default(PENDING)
  stripeCheckoutSessionId String?                    @unique
  createdAt               DateTime                   @default(now())

  workshopId String?
  workshop   Workshop? @relation(fields: [workshopId], references: [id], onDelete: SetNull)

  @@map("workshop_registrations")
}

// ============================================================
// CONTACT
// ============================================================

// ============================================================
// INSIGHTS
// ============================================================

model InsightCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  insights  Insight[]
  createdAt DateTime  @default(now())

  @@map("insight_categories")
}

model Author {
  id        String    @id @default(cuid())
  name      String
  jobTitle  String?
  bio       String?
  avatar    String? // URL
  insights  Insight[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("authors")
}

model Insight {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String
  body        String    @db.Text
  featured    Boolean   @default(false)
  published   Boolean   @default(false)
  readTime    String    @default("5 min read")
  coverImage  String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  authorId String?
  author   Author? @relation(fields: [authorId], references: [id])

  categoryId String?
  category   InsightCategory? @relation(fields: [categoryId], references: [id])

  createdById String
  createdBy   User   @relation("InsightAuthor", fields: [createdById], references: [id])

  @@map("insights")
}

enum ContactSubject {
  ENQUIRY
  PROGRAMS
  PARTNERSHIPS
  MEDIA
  OTHER
}

enum ContactStatus {
  NEW
  READ
  REPLIED
}

model ContactMessage {
  id        String         @id @default(cuid())
  firstName String
  lastName  String
  email     String
  phone     String?
  subject   ContactSubject @default(ENQUIRY)
  message   String
  status    ContactStatus  @default(NEW)
  createdAt DateTime       @default(now())

  @@map("contact_messages")
}

// ============================================================
// NEWSLETTER
// ============================================================

enum SubscriptionStatus {
  ACTIVE
  UNSUBSCRIBED
}

model NewsletterSubscriber {
  id             String             @id @default(cuid())
  email          String             @unique
  status         SubscriptionStatus @default(ACTIVE)
  subscribedAt   DateTime           @default(now())
  unsubscribedAt DateTime?

  @@map("newsletter_subscribers")
}

// ============================================================
// AUTH TOKENS
// ============================================================

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// ============================================================
// CAREERS
// ============================================================

enum CareerType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
}

enum ExperienceLevel {
  ENTRY
  JUNIOR
  MID
  SENIOR
  LEAD
  EXECUTIVE
}

enum CareerStatus {
  PUBLISHED
  ARCHIVED
}

model CareerDepartment {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("career_departments")
}

model Career {
  id               String          @id @default(cuid())
  title            String
  slug             String          @unique
  department       String
  type             CareerType      @default(FULL_TIME)
  experienceLevel  ExperienceLevel @default(MID)
  location         String
  remote           Boolean         @default(false)
  salaryMin        Float?
  salaryMax        Float?
  currency         String          @default("USD")
  description      String          @db.Text
  responsibilities Json? // String[]
  requirements     Json? // String[]
  benefits         Json? // String[]
  applyEmail       String?
  status           CareerStatus    @default(PUBLISHED)
  views            Int             @default(0)
  applications     Int             @default(0)
  closingDate      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  applicants CareerApplication[]

  @@map("careers")
}

model CareerApplication {
  id             String   @id @default(cuid())
  fullName       String
  email          String
  mobile         String
  country        String
  coverLetterUrl String?
  resumeUrl      String
  linkedinUrl    String?
  source         String?
  createdAt      DateTime @default(now())

  careerId String
  career   Career @relation(fields: [careerId], references: [id], onDelete: Cascade)

  @@index([careerId])
  @@map("career_applications")
}

// ============================================================
// TEAM
// ============================================================

enum TeamCategory {
  EXECUTIVE_MANAGEMENT
  STAFF
}

model TeamMember {
  id           String       @id @default(cuid())
  name         String
  position     String
  category     TeamCategory @default(STAFF)
  coverImage   String?
  description  String?      @db.Text
  displayOrder Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([category, displayOrder])
  @@map("team_members")
}

// ============================================================
// RESEARCH PROJECTS
// ============================================================

enum ProjectStatus {
  COMPLETE
  ACTIVE
}

model ProjectDivision {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  projects  Project[]
  createdAt DateTime  @default(now())

  @@map("project_divisions")
}

model ProjectDepartment {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  projects  Project[]
  createdAt DateTime  @default(now())

  @@map("project_departments")
}

model ProjectService {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  projects  Project[]
  createdAt DateTime  @default(now())

  @@map("project_services")
}

model Project {
  id           String        @id @default(cuid())
  title        String
  slug         String        @unique
  excerpt      String        @db.Text
  description  String        @db.Text
  coverImage   String?
  status       ProjectStatus @default(ACTIVE)
  client       String
  clientLogo   String?
  startDate    DateTime?
  endDate      DateTime?
  displayOrder Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  divisionId String?
  division   ProjectDivision? @relation(fields: [divisionId], references: [id])

  departmentId String?
  department   ProjectDepartment? @relation(fields: [departmentId], references: [id])

  services ProjectService[]

  // People (project-scoped JSON arrays; not reusable across projects)
  investigators Json? // Array<{ imageUrl?: string; name: string; role?: string }>
  members       Json? // Array<{ imageUrl?: string; name: string; role?: string }>

  @@index([status, displayOrder])
  @@map("projects")
}

// ============================================================
// ORGANIZATIONS
// ============================================================

model Organization {
  id           String   @id @default(cuid())
  name         String
  logo         String
  url          String?
  description  String?  @db.Text
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
  @@map("organizations")
}

// ============================================================
// GLOBAL OFFICES
// ============================================================

enum OfficeRegion {
  AFRICA
  AMERICAS
  ASIA
  EUROPE
  OCEANIA
  MIDDLE_EAST
}

model GlobalOffice {
  id           String       @id @default(cuid())
  city         String
  country      String
  region       OfficeRegion @default(AFRICA)
  addressLine1 String
  addressLine2 String?
  postalCode   String?
  phone        String?
  email        String?
  mapUrl       String?
  coverImage   String?
  displayOrder Int          @default(0)
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([region, displayOrder])
  @@map("global_offices")
}
